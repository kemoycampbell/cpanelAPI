{
  "name": "kemoycampbell/cpanel",
  "type": "library",
  "description": "A comprehensive API built for managing cPanel functionalities, consisting of modular components for FTP, Email, Domain management, and more.",
  "keywords": [
    "cpanel",
    "cpanelapi",
    "php cpanel api",
    "cpanel library",
    "cpanel sdk",
    "control panel automation",
    "cpanel integration"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Kemoy Campbell",
      "email": "kemoycampbell45@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11",
    "squizlabs/php_codesniffer": "3.*",
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.54",
    "symfony/dotenv": "^5.3"
  },
  "autoload": {
    "psr-4": {
      "KemoyCampbell\\CpanelAPI\\API\\": "src/API/",
      "KemoyCampbell\\CpanelAPI\\Components\\": "src/Components"
    }
  },
  "autoload-dev": {
    "files": [
      "load_test_credential.php"
    ]
  }
}
