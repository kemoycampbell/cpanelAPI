<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" bootstrap="vendor/autoload.php" colors="true" cacheResult="false" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.1/phpunit.xsd" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="Unit Tests">
      <directory>./src/API/tests/</directory>
    </testsuite>
  </testsuites>
  <coverage>
  <include>
    <directory>./src/</directory>
  </include>
  </coverage>

</phpunit>
